{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "admin.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/notify-admin",
      "dest": "/api/notify-admin.js"
    },
    {
      "src": "/api/notify-user",
      "dest": "/api/notify-user.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
